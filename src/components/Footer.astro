---
import Icon from './Icon.astro';
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <svg class="torn" viewBox="0 0 1200 28" preserveAspectRatio="none" aria-hidden="true"><path fill="currentColor" d="M0 28V10l40 8 30-12 45 10 38-14 52 15 24-9 60 11 35-13 48 12 30-7 55 9 40-14 46 13 28-8 62 12 33-10 50 9 36-13 47 14 29-8 58 10 34-12 49 11 31-9 54 12 39-11 44 8 27-6 21 4v14Z"/></svg>
  <div class="footer-body">
    <div class="wrap footer-grid">
      <div class="footer-brand">
        <img src="/img/logo-troy.webp" alt="Troy" width="160" height="90" loading="lazy" />
        <p class="muted">Guitarrista, metaleira e nerd assumida. Decks de Commander toda semana, riff pesado e RPG de mesa.</p>
        <p class="stay">Stay metal! 🤘</p>
      </div>
      <nav aria-label="Rodapé">
        <h3>Decks</h3>
        <ul>
          <li><a href="/decks-commander">Todos de Commander</a></li>
          <li><a href="/decks-commander/mono-colored">Mono-colored</a></li>
          <li><a href="/decks-commander/duas-cores">Duas cores</a></li>
          <li><a href="/decks-commander/tres-cores">Três cores</a></li>
          <li><a href="/decks-commander/wubrg">WUBRG</a></li>
          <li><a href="/decks-pauper">Pauper</a></li>
        </ul>
      </nav>
      <div>
        <h3>Troy</h3>
        <ul>
          <li><a href="https://tabs.iamtroy.com.br" target="_blank" rel="noopener">TABS by Troy</a></li>
          <li><a href="https://bandway-3d8ff.web.app" target="_blank" rel="noopener">BandWay</a></li>
          <li><a href="/parcerias">Cupons e parcerias</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
        <div class="socials">
          <a href={site.social.instagram} target="_blank" rel="noopener me" aria-label="Instagram"><Icon name="instagram" size={22} /></a>
          <a href={site.social.tiktok} target="_blank" rel="noopener me" aria-label="TikTok"><Icon name="tiktok" size={22} /></a>
          <a href={site.social.youtube} target="_blank" rel="noopener me" aria-label="YouTube"><Icon name="youtube" size={22} /></a>
        </div>
      </div>
    </div>
    <div class="wrap legal">
      <p>© {year} Troy. Nothing is true, everything is permitted.</p>
      <p>Magic: The Gathering é marca da Wizards of the Coast. Imagens de cartas via Scryfall. Este site não é afiliado à Wizards.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { margin-top: 0; color: var(--bg-2); }
  .footer-body { background: var(--bg-2); color: var(--text); padding: 48px 0 28px; }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 40px; }
  .footer-brand img { width: 150px; margin-bottom: 16px; }
  .footer-brand p { max-width: 36ch; }
  .stay { font-family: var(--font-hand); font-size: 1.7rem; color: var(--red-hot); }
  h3 { font-size: 0.95rem; color: var(--faint); letter-spacing: .16em; margin-bottom: 14px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  ul a { text-decoration: none; color: var(--muted); display: inline-block; padding: 6px 0; overflow-wrap: anywhere; }
  ul a:hover { color: #fff; }
  .socials { display: flex; gap: 10px; margin-top: 18px; }
  .socials a { width: 46px; height: 46px; display: grid; place-items: center; border: 1px solid var(--line-strong); border-radius: 50%; color: var(--text); transition: background-color .15s, border-color .15s; }
  .socials a:hover { background: var(--red); border-color: var(--red); }
  .legal { margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--line); font-size: .85rem; color: var(--faint); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 24px; }
  .legal p { margin: 0; }
  @media (max-width: 760px) { .footer-grid { grid-template-columns: 1fr 1fr; } .footer-brand { grid-column: 1 / -1; } }
</style>
