---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DeckCard from '../components/DeckCard.astro';
import Pips from '../components/Pips.astro';
import Icon from '../components/Icon.astro';
import Prose from '../components/Prose.astro';
import { decks, category, colorCategories, categoryPath, decksIn, GROUPS } from '../lib/data';

const cat = category('decks-commander');
const list = decks.filter((d) => d.format === 'commander').sort((a, b) => a.name.localeCompare(b.name, 'pt'));
const colorsOf = (d: (typeof list)[number]) => (d.colors?.length ? d.colors.join('') : category(d.category).colors ?? 'C');
---
<Base
  title={`Decks de Commander (EDH): ${list.length} listas completas por cor`}
  description={`Todos os ${list.length} decks de Commander da Troy, com lista completa pra copiar. Busque pelo comandante ou filtre por cor: mono, guildas, três cores e WUBRG.`}
>
  <header class="page-hero">
    <div class="wrap">
      <Breadcrumbs items={[{ name: 'Commander' }]} />
      <h1>Decks Commander</h1>
      <Prose blocks={cat.intro} />
      <p class="muted">Ache o deck do vídeo: busque pelo nome do comandante ou filtre pelas cores.</p>
    </div>
  </header>

  <section class="section section--tight">
    <div class="wrap">
      <div class="filters" id="filtros">
        <label class="search">
          <Icon name="search" />
          <span class="sr-only">Buscar comandante</span>
          <input type="search" id="q" placeholder="Buscar comandante…" autocomplete="off" />
        </label>
        <div class="color-filter" role="group" aria-label="Filtrar por cor">
          {['W', 'U', 'B', 'R', 'G', 'C'].map((c) => (
            <button type="button" class="chip chip--pip" data-color={c} aria-pressed="false"><Pips colors={[c]} size="1.1rem" /></button>
          ))}
          <select id="mode" aria-label="Modo do filtro de cores">
            <option value="incl">Inclui as cores</option>
            <option value="exact">Exatamente essas cores</option>
          </select>
        </div>
      </div>
      <p class="result" aria-live="polite"><span id="n">{list.length}</span> decks</p>

      <div class="deck-grid" id="grid">
        {list.map((d, i) => <div class="cell" data-name={d.name.toLowerCase()} data-colors={colorsOf(d)}><DeckCard deck={d} eager={i < 4} /></div>)}
      </div>
      <p id="empty" class="muted" hidden>Nenhum deck com esse filtro. Tenta outro comandante!</p>
    </div>
  </section>

  <section class="section section--panel">
    <div class="wrap">
      <div class="section-head"><div><span class="kicker">Por cor</span><h2 class="h2">Navegue pelas combinações</h2></div></div>
      {GROUPS.map((g) => (
        <div class="grp">
          <h3><a href={`/decks-commander/${g.slug}`}>{g.name}</a></h3>
          <div class="chips">
            {colorCategories.filter((c) => c.group === g.slug).map((c) => (
              <a class="chip" href={categoryPath(c.slug)}><Pips colors={c.colors} />{c.name}<span class="count">{decksIn(c.slug).length}</span></a>
            ))}
          </div>
        </div>
      ))}
      <div class="grp">
        <h3>Cinco cores</h3>
        <div class="chips"><a class="chip" href="/decks-commander/wubrg"><Pips colors="WUBRG" />WUBRG<span class="count">{decksIn('wubrg').length}</span></a></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-hero :global(.prose) { max-width: 62ch; color: var(--muted); font-size: 1.1rem; }
  .filters { display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: center; margin-bottom: 14px; }
  .search { flex: 1 1 280px; display: flex; align-items: center; gap: 10px; min-height: 50px; padding: 0 16px; background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--radius); color: var(--muted); }
  .search:focus-within { border-color: var(--red-hot); }
  .search input { flex: 1; min-width: 0; background: none; border: 0; color: var(--text); font: inherit; font-size: 1.05rem; outline: none; height: 48px; }
  .color-filter { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .chip--pip { padding: 0 12px; }
  .chip--pip[aria-pressed='true'] { background: var(--red); border-color: var(--red-hot); }
  select { min-height: 40px; background: var(--surface); color: var(--text); border: 1px solid var(--line); border-radius: 999px; padding: 0 14px; font: 600 .9rem var(--font-label); letter-spacing: .06em; text-transform: uppercase; }
  .result { font: 600 .9rem/1 var(--font-label); letter-spacing: .12em; text-transform: uppercase; color: var(--faint); margin: 0 0 20px; }
  .cell[hidden] { display: none; }
  .cell :global(.deck-card) { height: 100%; }
  .grp + .grp { margin-top: 26px; }
  .grp h3 { font-size: 1rem; letter-spacing: .16em; color: var(--faint); margin-bottom: 12px; }
  .grp h3 a { text-decoration: none; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
</style>

<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const mode = document.getElementById('mode') as HTMLSelectElement;
  const btns = [...document.querySelectorAll<HTMLButtonElement>('[data-color]')];
  const cells = [...document.querySelectorAll<HTMLElement>('#grid .cell')];
  const n = document.getElementById('n')!;
  const empty = document.getElementById('empty')!;
  const norm = (s: string) => s.normalize('NFKD').replace(/[̀-ͯ]/g, '').toLowerCase();

  function apply() {
    const term = norm(q.value.trim());
    const sel = btns.filter((b) => b.getAttribute('aria-pressed') === 'true').map((b) => b.dataset.color!);
    let shown = 0;
    for (const c of cells) {
      const colors = c.dataset.colors || 'C';
      let ok = !term || norm(c.dataset.name || '').includes(term);
      if (ok && sel.length) {
        ok = mode.value === 'exact'
          ? sel.length === colors.length && sel.every((x) => colors.includes(x))
          : sel.every((x) => colors.includes(x));
      }
      c.hidden = !ok;
      if (ok) shown++;
    }
    n.textContent = String(shown);
    empty.hidden = shown > 0;
    const params = new URLSearchParams();
    if (q.value) params.set('q', q.value);
    if (sel.length) params.set('cores', sel.join(''));
    if (mode.value === 'exact') params.set('exato', '1');
    history.replaceState(null, '', params.toString() ? `?${params}` : location.pathname);
  }

  btns.forEach((b) => b.addEventListener('click', () => { b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')); apply(); }));
  q.addEventListener('input', apply);
  mode.addEventListener('change', apply);

  const p = new URLSearchParams(location.search);
  if (p.get('q')) q.value = p.get('q')!;
  if (p.get('exato')) mode.value = 'exact';
  (p.get('cores') || '').split('').forEach((c) => btns.find((b) => b.dataset.color === c)?.setAttribute('aria-pressed', 'true'));
  if ([...p.keys()].length) apply();
</script>
